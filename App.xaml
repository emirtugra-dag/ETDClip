<Application x:Class="ETDClip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             Exit="Application_Exit"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global Font and Theme Colors -->
            <SolidColorBrush x:Key="GlassBackground" Color="#D9111827"/>
            <SolidColorBrush x:Key="GlassBorder" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
