<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Title>ETDClip Pano Yöneticisi</Title>
    <Authors>Emir Tuğra Dağ</Authors>
    <Company>Emir Tuğra Dağ</Company>
    <Copyright>Copyright (c) 2026 Emir Tuğra Dağ</Copyright>
    <Version>1.0.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- EmbeddedResource allows loading via GetManifestResourceStream at runtime
         (works correctly in single-file publish mode unlike Resource) -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ETDClip.Assets.app.ico"/>
    <EmbeddedResource Include="Assets\etdclip_logo.png" LogicalName="ETDClip.Assets.etdclip_logo.png"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
    <Page Remove="Installer\**" />
  </ItemGroup>

</Project>
